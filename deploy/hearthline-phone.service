# systemd unit for the phone. Install (on the Pi):
#   sudo cp deploy/hearthline-phone.service /etc/systemd/system/
#   sudo systemctl enable --now hearthline-phone
#   journalctl -u hearthline-phone -f     # watch the log
[Unit]
Description=Hearthline phone
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/hearthline
EnvironmentFile=/home/pi/hearthline/.env
ExecStart=/home/pi/hearthline/.venv/bin/hearthline-phone
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
