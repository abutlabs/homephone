# Copy to .env and fill in. Never commit .env.
#
# --- Ringing server (laptop or small server) ---------------------------
# From LiveKit Cloud > your project > Settings > Keys (docs/livekit-cloud.md)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Key for the laptop test page. Leave empty to get a random one at start.
HOMEPHONE_WEB_KEY=
HOMEPHONE_HOUSEHOLDS=households.json
# Dev only: phones that name a household join it without 'enroll'.
HOMEPHONE_AUTO_ENROLL=0

# --- Phone (Raspberry Pi) ----------------------------------------------
# The ringing server, usually your laptop's address on the home network.
HOMEPHONE_SERVER=ws://192.168.1.20:8080/ws
HOMEPHONE_PHONE_NAME=Kitchen phone
# Household this phone rings when the handset is lifted.
HOMEPHONE_DEFAULT_CALL=laptop
# Hook switch on BCM GPIO 17 to GND. "open" = switch opens when lifted.
HOMEPHONE_HOOK_PIN=17
HOMEPHONE_OFF_HOOK_WHEN=open
# Sound cards, by part of their name (list them: python -m sounddevice)
HOMEPHONE_HANDSET_DEVICE=USB Audio
HOMEPHONE_RINGER_DEVICE=UACDemo
# Mock hardware: all, or a comma list of hook,audio,ringer
HOMEPHONE_MOCK=
